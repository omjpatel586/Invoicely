{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "NodeNext",
    "types": ["node"],
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictPropertyInitialization": false
  },
  "include": ["**/*.ts"],
  "references": [
    {
      "path": "../../shared/utils/tsconfig.lib.json"
    },
    {
      "path": "../../shared/api-interfaces/tsconfig.lib.json"
    },
    {
      "path": "../../shared/constants/tsconfig.lib.json"
    }
  ]
}
